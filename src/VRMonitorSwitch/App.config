<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!--
    app.manifest declares PerMonitorV2 so the OS never bitmap-stretches the window, but on .NET Framework 4.7+
    WinForms only rescales on WM_DPICHANGED (and reports the real Control.DeviceDpi) when this opt-in is present.
    Without it the window keeps its pixel size when dragged to a monitor with a different scale and
    Theme.Scale is a no-op even on a single 200 % laptop panel.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
